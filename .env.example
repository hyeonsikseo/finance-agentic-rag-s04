# OpenAI 키는 메타코드에서 발급해 줍니다. 받으면 복사해서 .env 로 저장하고 키를 채웁니다(5회차부터 씁니다. 3회차 선택 과제에도).
#   cp .env.example .env
# .env 는 커밋되지 않습니다. 값 뒤에 같은 줄로 주석을 달지 마세요(주석이 값으로 읽힙니다).

OPENAI_API_KEY=
LLM_MODEL_MAIN=openai:gpt-5.4-mini

# ── 4회차 ──
# 리랭커. 기본은 BAAI/bge-reranker-v2-m3 (2.2GB). 메모리 8GB 노트북이면 작은 모델로 바꿉니다.
# RERANKER_MODEL=BAAI/bge-reranker-base
# 리랭커에 넣는 후보 수. 기본 10. 실습 3(make rerank-sweep)에서 고른 값으로 바꿔도 됩니다.
# RERANK_CANDIDATES=10
